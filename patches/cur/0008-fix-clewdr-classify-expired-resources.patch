   })
+
+  it('reuploads an expired staged file, updates the cache, and retries without resetting', async () => {
+    const calls: Array<{ url: string; body: string }> = []
+    let uploadCount = 0
+    let messageCount = 0
+    const upstream = vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
+      const url = String(input)
+      calls.push({ url, body: String(init?.body) })
+      if (url.endsWith('/files')) {
+        uploadCount += 1
+        return new Response(
+          JSON.stringify({
+            id: `file_clewdr_v1_upload_${uploadCount}`,
+            type: 'file',
+            filename: 'project.zip',
+            mime_type: 'application/zip',
+            size_bytes: 4
+          }),
+          { status: 200 }
+        )
+      }
+      messageCount += 1
+      if (messageCount <= 2) {
+        return new Response(
+          JSON.stringify({ type: 'error', error: { type: 'file_expired', message: 'Staged file has expired' } }),
+          { status: 410 }
+        )
+      }
+      return okStream()
+    }) as typeof globalThis.fetch
+    const fetch = makeFetch(upstream)
+
+    const firstResponse = await fetch(messagesUrl, { method: 'POST', body: JSON.stringify(makeBody()) })
+    const secondResponse = await fetch(messagesUrl, { method: 'POST', body: JSON.stringify(makeBody()) })
+
+    expect(firstResponse.status).toBe(410)
+    expect(secondResponse.status).toBe(200)
+    expect(uploadCount).toBe(2)
+    expect(messageCount).toBe(3)
+    expect(calls.some((call) => call.url.endsWith('/sessions/reset'))).toBe(false)
+    const messageBodies = calls.filter((call) => call.url === messagesUrl).map((call) => call.body)
+    expect(messageBodies).toHaveLength(3)
+    expect(messageBodies.every((body) => !body.includes('UEsDBA=='))).toBe(true)
+    expect(messageBodies[0]).toContain('file_clewdr_v1_upload_1')
+    expect(messageBodies[1]).toContain('file_clewdr_v1_upload_2')
+    expect(messageBodies[2]).toBe(messageBodies[1])
+  })
+
+  it.each([
+    ['flat conversation_expired', { type: 'conversation_expired' }],
+    ['unknown nested error', { type: 'error', error: { type: 'other_gone', message: 'gone' } }]
+  ])('returns %s 410 envelopes unchanged without recovery', async (_name, envelope) => {
+    const upstream = vi.fn(
+      async () => new Response(JSON.stringify(envelope), { status: 410 })
+    ) as typeof globalThis.fetch
+    const response = await makeFetch(upstream)(messagesUrl, {
+      method: 'POST',
+      body: JSON.stringify({ model: 'claude-sonnet-4-6', messages: [] })
+    })
+
+    expect(response.status).toBe(410)
+    await expect(response.json()).resolves.toEqual(envelope)
+    expect(upstream).toHaveBeenCalledTimes(1)
+  })
+
+  it('rejects upload responses whose id is outside the staged file namespace', async () => {
+    const upstream = vi.fn(async (input: RequestInfo | URL) => {
+      if (String(input).endsWith('/files')) {
+        return new Response(
+          JSON.stringify({
+            id: 'file_other_abc',
+            type: 'file',
+            filename: 'project.zip',
+            mime_type: 'application/zip',
+            size_bytes: 4
+          }),
+          { status: 200 }
+        )
+      }
+      return okStream()
+    }) as typeof globalThis.fetch
+
+    await expect(
+      makeFetch(upstream)(messagesUrl, { method: 'POST', body: JSON.stringify(makeBody()) })
+    ).rejects.toThrow('invalid response')
+    expect(upstream).toHaveBeenCalledTimes(1)
+  })
 })

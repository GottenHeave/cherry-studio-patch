From f2431c9226b5edbce93efbcaba9d282ffd96b1e1 Mon Sep 17 00:00:00 2001
From: PatchReplay <patch-replay@localhost>
Date: Wed, 15 Jul 2026 18:29:41 +0000
Subject: [PATCH] fix(tool-display): render unknown provider tools

Signed-off-by: PatchReplay <patch-replay@localhost>
---
 .../messages/tools/__tests__/chooseTool.test.tsx |  4 ++++
 .../chat/messages/tools/chooseTool.tsx           | 16 ++--------------
 2 files changed, 6 insertions(+), 14 deletions(-)

diff --git a/src/renderer/components/chat/messages/tools/__tests__/chooseTool.test.tsx b/src/renderer/components/chat/messages/tools/__tests__/chooseTool.test.tsx
index 7474b21..d5a1399 100644
--- a/src/renderer/components/chat/messages/tools/__tests__/chooseTool.test.tsx
+++ b/src/renderer/components/chat/messages/tools/__tests__/chooseTool.test.tsx
@@ -48,4 +48,8 @@ describe('chooseTool', () => {
     expect(testIdOf(chooseTool(resp('generate_image', 'mcp')))).toBe('image-card')
     expect(testIdOf(chooseTool(resp('mcp__cherry-tools__generate_image')))).toBe('image-card')
   })
+
+  it('routes unknown provider tools through the generic agent card', () => {
+    expect(testIdOf(chooseTool(resp('view', 'provider')))).toBe('agent-card')
+  })
 })
diff --git a/src/renderer/components/chat/messages/tools/chooseTool.tsx b/src/renderer/components/chat/messages/tools/chooseTool.tsx
index c2b3398..f2727e8 100644
--- a/src/renderer/components/chat/messages/tools/chooseTool.tsx
+++ b/src/renderer/components/chat/messages/tools/chooseTool.tsx
@@ -5,23 +5,14 @@ import { AgentExecutionTimeline } from './agent'
 import { MessageKnowledgeSearchToolTitle } from './knowledge/MessageKnowledgeSearch'
 import MessageMetaTool, { isMetaToolName } from './meta/MessageMetaTool'
 import { MessageGenerateImageToolTitle } from './painting/MessageGenerateImage'
-import { AgentToolsType, isAskUserQuestionToolName } from './shared/agentToolTypes'
+import { isAskUserQuestionToolName } from './shared/agentToolTypes'
 import { MessageWebSearchToolTitle } from './webSearch/MessageWebSearch'
 
 const builtinToolsPrefix = 'builtin_'
-const agentMcpToolsPrefix = 'mcp__'
 const agentGenerateImageToolName = `mcp__cherry-tools__${GENERATE_IMAGE_TOOL_NAME}`
-const agentTools = new Set<string>(Object.values(AgentToolsType))
 /** cherry-tools that carry short wire names (no `mcp__` prefix) and lack a bespoke card. */
 const CHERRY_AGENT_TOOL_NAMES = new Set(['web_fetch', 'kb_list', 'memory'])
 
-const isAgentTool = (toolName: string) => {
-  if (agentTools.has(toolName) || toolName.startsWith(agentMcpToolsPrefix)) {
-    return true
-  }
-  return false
-}
-
 export function chooseTool(toolResponse: NormalToolResponse): React.ReactNode | null {
   const toolName = toolResponse.tool.name
   const toolType = toolResponse.tool.type
@@ -63,8 +54,5 @@ export function chooseTool(toolResponse: NormalToolResponse): React.ReactNode |
     }
   }
 
-  if (isAgentTool(toolName)) {
-    return <AgentExecutionTimeline toolResponse={toolResponse} />
-  }
-  return null
+  return <AgentExecutionTimeline toolResponse={toolResponse} />
 }

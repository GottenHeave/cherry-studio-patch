--- a/src/main/ai/provider/custom/clewdrProvider.ts
+++ b/src/main/ai/provider/custom/clewdrProvider.ts
@@ -1,7 +1,283 @@
+import { createHash } from 'node:crypto'
+
 import { type AnthropicProvider, type AnthropicProviderSettings, createAnthropic } from '@ai-sdk/anthropic'
 
-export type ClewdrProviderSettings = AnthropicProviderSettings
+const CLEWDR_SESSION_PREFIX = 'cherry_topic_v1_'
+const CLEWDR_SESSION_DOMAIN = 'clewdr-cherry-session-v1'
+const MAX_UPLOAD_CACHE_ENTRIES = 1024
+
+interface UploadCacheEntry {
+  promise: Promise<string>
+  settled: boolean
+}
+
+// Agent construction may repeat between turns. Keep completed uploads across provider wrappers while retaining
+// in-flight entries until they settle so concurrent requests cannot duplicate a multipart upload.
+const uploadCache = new Map<string, UploadCacheEntry>()
+const fetchIdentities = new WeakMap<typeof globalThis.fetch, number>()
+let nextFetchIdentity = 1
+
+export interface ClewdrProviderSettings extends AnthropicProviderSettings {
+  clientId?: string
+  sessionId?: string
+  normalizedEndpoint?: string
+}
+
+interface ClewdrFetchSettings {
+  apiKey?: string
+  clientId: string
+  sessionId: string
+  normalizedEndpoint: string
+  fetch: typeof globalThis.fetch
+}
+
+interface StagedFileResponse {
+  id: string
+  type: 'file'
+  filename: string
+  mime_type: string
+  size_bytes: number
+}
+
+type JsonObject = Record<string, unknown>
+
+export function normalizeClewdrEndpoint(endpoint: string): string {
+  const url = new URL(endpoint)
+  url.search = ''
+  url.hash = ''
+  url.pathname = url.pathname.replace(/\/+$/, '')
+  return url.toString().replace(/\/$/, '')
+}
 
 export function createClewdrProvider(options: ClewdrProviderSettings = {}): AnthropicProvider {
-  return createAnthropic({ ...options, name: 'clewdr' })
+  const { clientId, sessionId, normalizedEndpoint, fetch: customFetch, ...anthropicOptions } = options
+  let providerFetch = customFetch
+
+  if (sessionId !== undefined) {
+    if (!clientId) throw new Error('Clewdr session preparation requires a persisted Cherry client ID')
+    if (!sessionId) throw new Error('Clewdr session preparation requires a topic ID')
+
+    const endpoint = normalizeClewdrEndpoint(normalizedEndpoint ?? anthropicOptions.baseURL ?? '')
+    providerFetch = createClewdrFetch({
+      ...anthropicOptions,
+      clientId,
+      sessionId,
+      normalizedEndpoint: endpoint,
+      fetch: customFetch ?? globalThis.fetch
+    })
+  }
+
+  return createAnthropic({ ...anthropicOptions, fetch: providerFetch, name: 'clewdr' })
+}
+
+export function createClewdrFetch(settings: ClewdrFetchSettings): typeof globalThis.fetch {
+  const endpoint = normalizeClewdrEndpoint(settings.normalizedEndpoint)
+  const wireSessionId = createSessionId(settings.clientId, endpoint, settings.sessionId)
+  const principalDigest = sha256(settings.apiKey ?? '')
+  const fetchIdentity = getFetchIdentity(settings.fetch)
+
+  return async (input, init) => {
+    if (!isMessagesRequest(input) || typeof init?.body !== 'string') return settings.fetch(input, init)
+
+    const parsed: unknown = JSON.parse(init.body)
+    if (!isJsonObject(parsed)) return settings.fetch(input, init)
+
+    await rewriteFileSources(parsed, {
+      endpoint,
+      fetchIdentity,
+      principalDigest,
+      wireSessionId,
+      headers: mergeHeaders(input, init.headers),
+      signal: init.signal,
+      fetch: settings.fetch
+    })
+    parsed.metadata = {
+      ...(isJsonObject(parsed.metadata) ? parsed.metadata : {}),
+      user_id: wireSessionId
+    }
+    delete parsed.tools
+    delete parsed.tool_choice
+
+    const messageHeaders = mergeHeaders(input, init.headers)
+    messageHeaders.delete('content-length')
+    const rewrittenInit: RequestInit = { ...init, body: JSON.stringify(parsed), headers: messageHeaders }
+    const response = await settings.fetch(input, rewrittenInit)
+    if (response.status !== 410) return response
+    if (response.body) await response.body.cancel().catch(() => undefined)
+
+    const resetHeaders = new Headers(messageHeaders)
+    resetHeaders.set('content-type', 'application/json')
+    resetHeaders.delete('content-length')
+    const resetResponse = await settings.fetch(`${endpoint}/sessions/reset`, {
+      method: 'POST',
+      body: JSON.stringify({ session_id: wireSessionId }),
+      headers: resetHeaders,
+      signal: init.signal
+    })
+    if (!resetResponse.ok) return resetResponse
+
+    return settings.fetch(input, rewrittenInit)
+  }
+}
+
+interface RewriteContext {
+  endpoint: string
+  fetchIdentity: number
+  principalDigest: string
+  wireSessionId: string
+  headers: Headers
+  signal: AbortSignal | null | undefined
+  fetch: typeof globalThis.fetch
+}
+
+async function rewriteFileSources(body: JsonObject, context: RewriteContext): Promise<void> {
+  if (!Array.isArray(body.messages)) return
+
+  const rewrites: Promise<void>[] = []
+  for (const message of body.messages) {
+    if (!isJsonObject(message) || !Array.isArray(message.content)) continue
+    for (const part of message.content) {
+      if (!isJsonObject(part) || !isJsonObject(part.source)) continue
+      const source = part.source
+      if (source.type !== 'base64' || typeof source.data !== 'string' || typeof source.media_type !== 'string') {
+        continue
+      }
+
+      const filename = normalizeFilename(typeof part.title === 'string' ? part.title : 'file')
+      rewrites.push(
+        stageFile(source.data, filename, source.media_type, context).then((fileId) => {
+          part.source = { type: 'file', file_id: fileId }
+        })
+      )
+    }
+  }
+  await Promise.all(rewrites)
+}
+
+function stageFile(data: string, filename: string, mediaType: string, context: RewriteContext): Promise<string> {
+  const bytes = Buffer.from(data, 'base64')
+  const cacheKey = JSON.stringify([
+    context.fetchIdentity,
+    context.endpoint,
+    context.principalDigest,
+    context.wireSessionId,
+    sha256(bytes),
+    filename,
+    mediaType
+  ])
+  const cached = uploadCache.get(cacheKey)
+  if (cached) {
+    uploadCache.delete(cacheKey)
+    uploadCache.set(cacheKey, cached)
+    return cached.promise
+  }
+
+  reserveUploadCacheEntry()
+  const entry: UploadCacheEntry = {
+    settled: false,
+    promise: uploadFile(bytes, filename, mediaType, context).then(
+      (fileId) => {
+        entry.settled = true
+        return fileId
+      },
+      (error: unknown) => {
+        if (uploadCache.get(cacheKey) === entry) uploadCache.delete(cacheKey)
+        throw error
+      }
+    )
+  }
+  uploadCache.set(cacheKey, entry)
+  return entry.promise
+}
+
+async function uploadFile(
+  bytes: Uint8Array,
+  filename: string,
+  mediaType: string,
+  context: RewriteContext
+): Promise<string> {
+  const form = new FormData()
+  const blobBytes = new Uint8Array(bytes.byteLength)
+  blobBytes.set(bytes)
+  form.append('file', new Blob([blobBytes.buffer], { type: mediaType }), filename)
+  const headers = new Headers(context.headers)
+  headers.delete('content-type')
+  headers.delete('content-length')
+
+  const response = await context.fetch(`${context.endpoint}/files`, {
+    method: 'POST',
+    body: form,
+    headers,
+    signal: context.signal
+  })
+  if (!response.ok) {
+    const detail = await response.text()
+    throw new Error(`Clewdr file upload failed with HTTP ${response.status}: ${detail}`)
+  }
+
+  const payload: unknown = await response.json()
+  if (!isStagedFileResponse(payload)) throw new Error('Clewdr file upload returned an invalid response')
+  return payload.id
+}
+
+function createSessionId(clientId: string, endpoint: string, topicId: string): string {
+  return `${CLEWDR_SESSION_PREFIX}${sha256(`${CLEWDR_SESSION_DOMAIN}\0${clientId}\0${endpoint}\0${topicId}`)}`
+}
+
+function normalizeFilename(filename: string): string {
+  const basename = filename.replaceAll('\\', '/').split('/').filter(Boolean).at(-1) ?? 'file'
+  const printable = [...basename].filter((character) => {
+    const codePoint = character.codePointAt(0) ?? 0
+    return codePoint > 0x1f && codePoint !== 0x7f
+  })
+  return printable.join('').trim() || 'file'
+}
+
+function mergeHeaders(input: RequestInfo | URL, headers: HeadersInit | undefined): Headers {
+  const merged = input instanceof Request ? new Headers(input.headers) : new Headers()
+  new Headers(headers).forEach((value, key) => merged.set(key, value))
+  return merged
+}
+
+function getFetchIdentity(fetch: typeof globalThis.fetch): number {
+  const existing = fetchIdentities.get(fetch)
+  if (existing !== undefined) return existing
+  const identity = nextFetchIdentity++
+  fetchIdentities.set(fetch, identity)
+  return identity
+}
+
+function reserveUploadCacheEntry(): void {
+  if (uploadCache.size < MAX_UPLOAD_CACHE_ENTRIES) return
+  const settled = uploadCache.entries().find(([, entry]) => entry.settled)
+  if (!settled) throw new Error('Clewdr file upload cache is busy')
+  uploadCache.delete(settled[0])
+}
+
+function isMessagesRequest(input: RequestInfo | URL): boolean {
+  const url = input instanceof Request ? input.url : String(input)
+  try {
+    return new URL(url).pathname.replace(/\/+$/, '').endsWith('/messages')
+  } catch {
+    return false
+  }
+}
+
+function isJsonObject(value: unknown): value is JsonObject {
+  return typeof value === 'object' && value !== null && !Array.isArray(value)
+}
+
+function isStagedFileResponse(value: unknown): value is StagedFileResponse {
+  return (
+    isJsonObject(value) &&
+    typeof value.id === 'string' &&
+    value.type === 'file' &&
+    typeof value.filename === 'string' &&
+    typeof value.mime_type === 'string' &&
+    typeof value.size_bytes === 'number'
+  )
+}
+
+function sha256(value: string | Uint8Array): string {
+  return createHash('sha256').update(value).digest('hex')
 }

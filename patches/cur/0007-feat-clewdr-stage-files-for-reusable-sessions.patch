+import { createHash } from 'node:crypto'
+
+import { describe, expect, it, vi } from 'vitest'
+
+import { createClewdrFetch, createClewdrProvider, normalizeClewdrEndpoint } from '../clewdrProvider'
+
+const clientId = 'client-123'
+const topicId = 'topic-456'
+const configuredEndpoint = 'HTTPS://CLEWDR.EXAMPLE:443/api/v1/?ignored=yes#fragment'
+const normalizedEndpoint = 'https://clewdr.example/api/v1'
+const sessionId = `cherry_topic_v1_${createHash('sha256')
+  .update(`clewdr-cherry-session-v1\0${clientId}\0${normalizedEndpoint}\0${topicId}`)
+  .digest('hex')}`
+
+const messagesUrl = `${normalizedEndpoint}/messages`
+
+function makeBody(filename = 'folder/project.zip', mediaType = 'application/zip') {
+  const source = { type: 'base64', media_type: mediaType, data: 'UEsDBA==' }
+  return {
+    model: 'claude-sonnet-4-6',
+    system: 'Keep this exact system prompt',
+    metadata: { trace_id: 'trace-1', user_id: 'must-be-replaced' },
+    tools: [{ name: 'view', input_schema: { type: 'object' } }],
+    tool_choice: { type: 'auto' },
+    messages: [
+      { role: 'user', content: [{ type: 'document', source, title: filename }] },
+      { role: 'assistant', content: [{ type: 'text', text: '{"literal":true}' }] },
+      { role: 'user', content: [{ type: 'document', source: { ...source }, title: filename }] }
+    ]
+  }
+}
+
+function okStream(): Response {
+  return new Response('data: {"type":"message_stop"}\n\n', {
+    status: 200,
+    headers: { 'content-type': 'text/event-stream' }
+  })
+}
+
+function makeFetch(fetch: typeof globalThis.fetch) {
+  return createClewdrFetch({
+    apiKey: 'secret-key',
+    clientId,
+    sessionId: topicId,
+    normalizedEndpoint,
+    fetch
+  })
+}
+
+describe('Clewdr request boundary', () => {
+  it('canonicalizes the endpoint used by the session digest', () => {
+    expect(normalizeClewdrEndpoint(configuredEndpoint)).toBe(normalizedEndpoint)
+    expect(normalizeClewdrEndpoint('http://localhost:8484/v1///')).toBe('http://localhost:8484/v1')
+    expect(normalizeClewdrEndpoint('https://example.test:8443/root/')).toBe('https://example.test:8443/root')
+  })
+
+  it('uploads a repeated historical source once and rewrites the full history', async () => {
+    const calls: Array<{ url: string; init?: RequestInit }> = []
+    const upstream = vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
+      const url = String(input)
+      calls.push({ url, init })
+      if (url.endsWith('/files')) {
+        return new Response(
+          JSON.stringify({
+            id: 'file_clewdr_v1_abc',
+            type: 'file',
+            filename: 'project.zip',
+            mime_type: 'application/zip',
+            size_bytes: 4
+          }),
+          { status: 200, headers: { 'content-type': 'application/json' } }
+        )
+      }
+      return okStream()
+    }) as typeof globalThis.fetch
+    const fetch = makeFetch(upstream)
+    const signal = new AbortController().signal
+    const original = makeBody()
+
+    await fetch(messagesUrl, {
+      method: 'POST',
+      body: JSON.stringify(original),
+      headers: {
+        'content-type': 'application/json',
+        'content-length': '999',
+        'x-api-key': 'secret-key',
+        'x-trace': 'keep-me'
+      },
+      signal
+    })
+
+    expect(calls).toHaveLength(2)
+    expect(calls[0].url).toBe(`${normalizedEndpoint}/files`)
+    const uploadBody = calls[0].init?.body
+    expect(uploadBody).toBeInstanceOf(FormData)
+    if (!(uploadBody instanceof FormData)) throw new Error('expected multipart upload body')
+    const uploadedFile = uploadBody.get('file')
+    expect(uploadedFile).toBeInstanceOf(File)
+    expect((uploadedFile as File).name).toBe('project.zip')
+    expect((uploadedFile as File).type).toBe('application/zip')
+    expect(calls[0].init?.signal).toBe(signal)
+    const uploadHeaders = new Headers(calls[0].init?.headers)
+    expect(uploadHeaders.get('x-api-key')).toBe('secret-key')
+    expect(uploadHeaders.get('x-trace')).toBe('keep-me')
+    expect(uploadHeaders.has('content-type')).toBe(false)
+    expect(uploadHeaders.has('content-length')).toBe(false)
+
+    const sent = JSON.parse(String(calls[1].init?.body))
+    expect(sent).toEqual({
+      model: original.model,
+      system: original.system,
+      metadata: { trace_id: 'trace-1', user_id: sessionId },
+      messages: [
+        {
+          role: 'user',
+          content: [
+            { type: 'document', source: { type: 'file', file_id: 'file_clewdr_v1_abc' }, title: 'folder/project.zip' }
+          ]
+        },
+        { role: 'assistant', content: [{ type: 'text', text: '{"literal":true}' }] },
+        {
+          role: 'user',
+          content: [
+            { type: 'document', source: { type: 'file', file_id: 'file_clewdr_v1_abc' }, title: 'folder/project.zip' }
+          ]
+        }
+      ]
+    })
+    expect(sent).not.toHaveProperty('tools')
+    expect(sent).not.toHaveProperty('tool_choice')
+    expect(String(calls[1].init?.body)).not.toContain('UEsDBA==')
+    expect(calls[1].init?.signal).toBe(signal)
+    const messageHeaders = new Headers(calls[1].init?.headers)
+    expect(messageHeaders.get('content-type')).toBe('application/json')
+    expect(messageHeaders.get('x-trace')).toBe('keep-me')
+    expect(messageHeaders.has('content-length')).toBe(false)
+  })
+
+  it('reuses staged uploads across separate Clewdr provider constructions', async () => {
+    const calls: Array<{ url: string; init?: RequestInit }> = []
+    const upstream = vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
+      calls.push({ url: String(input), init })
+      if (String(input).endsWith('/files')) {
+        return new Response(
+          JSON.stringify({
+            id: 'file_clewdr_v1_sdk',
+            type: 'file',
+            filename: 'project.zip',
+            mime_type: 'application/zip',
+            size_bytes: 4
+          }),
+          { status: 200 }
+        )
+      }
+      return okStream()
+    }) as typeof globalThis.fetch
+
+    const streamFile = () =>
+      createClewdrProvider({
+        apiKey: 'secret-key',
+        baseURL: normalizedEndpoint,
+        clientId,
+        sessionId: topicId,
+        normalizedEndpoint,
+        fetch: upstream
+      })
+        .languageModel('claude-sonnet-4-6')
+        .doStream({
+          prompt: [
+            {
+              role: 'user',
+              content: [
+                {
+                  type: 'file',
+                  data: new Uint8Array([0x50, 0x4b, 0x03, 0x04]),
+                  mediaType: 'application/zip',
+                  filename: 'project.zip'
+                }
+              ]
+            }
+          ]
+        })
+
+    await streamFile()
+    await streamFile()
+
+    expect(calls.map((call) => call.url)).toEqual([`${normalizedEndpoint}/files`, messagesUrl, messagesUrl])
+    const sent = JSON.parse(String(calls[1].init?.body))
+    expect(sent.metadata).toEqual({ user_id: sessionId })
+    expect(sent.messages[0].content[0].source).toEqual({ type: 'file', file_id: 'file_clewdr_v1_sdk' })
+  })
+
+  it('requires a persisted client ID when a Clewdr topic session is enabled', () => {
+    expect(() =>
+      createClewdrProvider({
+        apiKey: 'secret-key',
+        baseURL: normalizedEndpoint,
+        sessionId: topicId,
+        normalizedEndpoint,
+        fetch: vi.fn()
+      })
+    ).toThrow('persisted Cherry client ID')
+  })
+
+  it('deduplicates cached and concurrent uploads by bytes, filename, and MIME', async () => {
+    let uploads = 0
+    let releaseUpload: (() => void) | undefined
+    const uploadBlocked = new Promise<void>((resolve) => {
+      releaseUpload = resolve
+    })
+    const upstream = vi.fn(async (input: RequestInfo | URL) => {
+      if (String(input).endsWith('/files')) {
+        uploads += 1
+        await uploadBlocked
+        return new Response(
+          JSON.stringify({
+            id: `file-${uploads}`,
+            type: 'file',
+            filename: 'project.zip',
+            mime_type: 'application/zip',
+            size_bytes: 4
+          }),
+          { status: 200 }
+        )
+      }
+      return okStream()
+    }) as typeof globalThis.fetch
+    const fetch = makeFetch(upstream)
+
+    const first = fetch(messagesUrl, { method: 'POST', body: JSON.stringify(makeBody()) })
+    const concurrent = fetch(messagesUrl, { method: 'POST', body: JSON.stringify(makeBody()) })
+    releaseUpload?.()
+    await Promise.all([first, concurrent])
+    await fetch(messagesUrl, { method: 'POST', body: JSON.stringify(makeBody()) })
+
+    expect(uploads).toBe(1)
+
+    await fetch(messagesUrl, { method: 'POST', body: JSON.stringify(makeBody('renamed.zip')) })
+    await fetch(messagesUrl, {
+      method: 'POST',
+      body: JSON.stringify(makeBody('project.zip', 'application/octet-stream'))
+    })
+    expect(uploads).toBe(3)
+  })
+
+  it('surfaces 409 without reset and resets then retries a 410 exactly once', async () => {
+    const conflict = vi.fn(
+      async () =>
+        new Response(
+          JSON.stringify({ type: 'error', error: { type: 'conversation_reuse_failed', message: 'mismatch' } }),
+          {
+            status: 409
+          }
+        )
+    ) as typeof globalThis.fetch
+    const conflictFetch = makeFetch(conflict)
+    const conflictResponse = await conflictFetch(messagesUrl, {
+      method: 'POST',
+      body: JSON.stringify({ model: 'claude-sonnet-4-6', messages: [] })
+    })
+    expect(conflictResponse.status).toBe(409)
+    expect(conflict).toHaveBeenCalledTimes(1)
+
+    const calls: Array<{ url: string; body: string }> = []
+    const expired = vi.fn(async (input: RequestInfo | URL, init?: RequestInit) => {
+      calls.push({ url: String(input), body: String(init?.body) })
+      if (String(input).endsWith('/files')) {
+        return new Response(
+          JSON.stringify({
+            id: 'file_clewdr_v1_abc',
+            type: 'file',
+            filename: 'project.zip',
+            mime_type: 'application/zip',
+            size_bytes: 4
+          }),
+          { status: 200 }
+        )
+      }
+      if (String(input).endsWith('/sessions/reset')) return new Response('{}', { status: 200 })
+      return new Response(
+        JSON.stringify({ type: 'error', error: { type: 'conversation_expired', message: 'expired' } }),
+        { status: 410 }
+      )
+    }) as typeof globalThis.fetch
+    const expiredFetch = makeFetch(expired)
+    const expiredResponse = await expiredFetch(messagesUrl, {
+      method: 'POST',
+      body: JSON.stringify(makeBody())
+    })
+
+    expect(expiredResponse.status).toBe(410)
+    expect(calls.map((call) => call.url)).toEqual([
+      `${normalizedEndpoint}/files`,
+      messagesUrl,
+      `${normalizedEndpoint}/sessions/reset`,
+      messagesUrl
+    ])
+    expect(JSON.parse(calls[2].body)).toEqual({ session_id: sessionId })
+    expect(calls[1].body).not.toContain('UEsDBA==')
+    expect(calls[3].body).toBe(calls[1].body)
+  })
+})

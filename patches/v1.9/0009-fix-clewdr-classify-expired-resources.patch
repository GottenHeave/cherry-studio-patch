+async function stageFile(
+  source: ClewdrFileSource,
+  filename: string,
+  context: RewriteContext
+): Promise<StagedFileReference> {
+  const bytes = decodeBase64(source.data)
+  const contentDigest = await sha256Hex(bytes)
+  const cacheKey = [
+    context.providerInstanceId,
+    context.endpoint,
+    context.principal,
+    context.sessionId,
+    contentDigest,
+    filename,
+    source.media_type
+  ].join('\0')
+  let fileId = stagedFiles.get(cacheKey)
+  if (!fileId) {
+    fileId = (async () => {
+      const form = new FormData()
+      form.append('file', new Blob([bytes], { type: source.media_type }), filename)
+      const uploadResponse = await context.fetch(`${context.endpoint}/files`, {
+        method: 'POST',
+        headers: cloneHeadersWithout(context.headers, ['content-length', 'content-type']),
+        body: form,
+        signal: context.signal
+      })
+      return (await parseStagedFileResponse(uploadResponse)).id
+    })()
+    rememberStagedFile(cacheKey, fileId)
+    fileId.catch(() => {
+      if (stagedFiles.get(cacheKey) === fileId) stagedFiles.delete(cacheKey)
+    })
+  }
+  return { cacheKey, fileId: await fileId }
+}
+
+async function prepareMessageBody(
+  originalBody: string,
+  context: RewriteContext
+): Promise<PreparedMessageBody | undefined> {
+  const parsed: unknown = JSON.parse(originalBody)
+  if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) return undefined
+  const body = parsed as AnthropicMessagesRequest
+  const rewrites = collectFileRewrites(body)
+  const uploadCacheKeys = new Set<string>()
+
+  await Promise.all(
+    rewrites.map(async ({ block, source, filename }) => {
+      const staged = await stageFile(source, filename, context)
+      block.source = { type: 'file', file_id: staged.fileId }
+      uploadCacheKeys.add(staged.cacheKey)
+    })
+  )
+
+  const metadata =
+    typeof body.metadata === 'object' && body.metadata !== null && !Array.isArray(body.metadata) ? body.metadata : {}
+  body.metadata = { ...metadata, user_id: context.sessionId }
+  delete body.tools
+  delete body.tool_choice
+  return { body: JSON.stringify(body), uploadCacheKeys }
+}
+
+async function readClewdrErrorType(response: Response): Promise<string | undefined> {
+  try {
+    const payload = (await response.clone().json()) as ClewdrErrorEnvelope
+    if (payload.type !== 'error' || typeof payload.error !== 'object' || payload.error === null) return undefined
+    if (typeof payload.error.type !== 'string' || typeof payload.error.message !== 'string') return undefined
+    return payload.error.type
+  } catch {
+    return undefined
+  }
+}

diff --git a/src/renderer/src/aiCore/provider/__tests__/clewdrCompatibility.test.ts b/src/renderer/src/aiCore/provider/__tests__/clewdrCompatibility.test.ts
new file mode 100644
index 000000000..589c2235c
--- /dev/null
+++ b/src/renderer/src/aiCore/provider/__tests__/clewdrCompatibility.test.ts
@@ -0,0 +1,150 @@
+import { createAnthropic } from '@ai-sdk/anthropic'
+import type { LanguageModelV3CallOptions, LanguageModelV3StreamPart } from '@ai-sdk/provider'
+import { describe, expect, it } from 'vitest'
+
+import { createClewdr } from '../custom/clewdr-provider'
+
+interface CapturedRequest {
+  body: unknown
+}
+
+async function captureWithFetch(
+  run: (fetch: typeof globalThis.fetch) => PromiseLike<unknown>
+): Promise<CapturedRequest> {
+  let body: unknown
+  const fetch = ((_url: RequestInfo | URL, init?: RequestInit) => {
+    body = typeof init?.body === 'string' ? JSON.parse(init.body) : init?.body
+    return Promise.resolve(new Response('{}', { status: 200 }))
+  }) as typeof globalThis.fetch
+
+  try {
+    await run(fetch)
+  } catch (error) {
+    if (body === undefined) throw error
+  }
+  return { body }
+}
+
+function createFilePrompt(filename?: string): LanguageModelV3CallOptions {
+  return {
+    prompt: [
+      {
+        role: 'user',
+        content: [
+          {
+            type: 'file',
+            data: new Uint8Array([0x50, 0x4b, 0x03, 0x04]),
+            mediaType: 'application/zip',
+            ...(filename !== undefined && { filename })
+          }
+        ]
+      }
+    ]
+  }
+}
+
+const textPrompt: LanguageModelV3CallOptions = {
+  prompt: [{ role: 'user', content: [{ type: 'text', text: 'hello' }] }]
+}
+
+describe('Clewdr Anthropic compatibility', () => {
+  it('sends arbitrary files as base64 documents with their MIME type and filename', async () => {
+    const request = await captureWithFetch((fetch) =>
+      createClewdr({ apiKey: 'test', baseURL: 'http://127.0.0.1:8484/v1', fetch })
+        .languageModel('claude-sonnet-4-6')
+        .doStream(createFilePrompt('project.zip'))
+    )
+
+    expect(request.body).toMatchObject({
+      messages: [
+        {
+          content: [
+            {
+              type: 'document',
+              source: { type: 'base64', media_type: 'application/zip', data: 'UEsDBA==' },
+              title: 'project.zip'
+            }
+          ]
+        }
+      ]
+    })
+  })
+
+  it('uses a fallback title when a file has no filename', async () => {
+    const request = await captureWithFetch((fetch) =>
+      createClewdr({ apiKey: 'test', fetch }).languageModel('claude-sonnet-4-6').doStream(createFilePrompt())
+    )
+
+    expect(request.body).toMatchObject({ messages: [{ content: [{ title: 'file' }] }] })
+  })
+
+  it('keeps arbitrary MIME rejection for the official Anthropic provider', async () => {
+    await expect(
+      captureWithFetch((fetch) =>
+        createAnthropic({ apiKey: 'test', fetch }).languageModel('claude-sonnet-4-6').doStream(createFilePrompt())
+      )
+    ).rejects.toThrow('media type: application/zip')
+  })
+
+  it('ignores unsupported proxy metadata events', async () => {
+    const fetch = (() =>
+      Promise.resolve(
+        new Response('data: {"type":"conversation_ready"}\n\n', {
+          headers: { 'content-type': 'text/event-stream' },
+          status: 200
+        })
+      )) as typeof globalThis.fetch
+    const result = await createClewdr({ apiKey: 'test', fetch }).languageModel('claude-sonnet-4-6').doStream(textPrompt)
+    const chunks: LanguageModelV3StreamPart[] = []
+    const reader = result.stream.getReader()
+    while (true) {
+      const { done, value } = await reader.read()
+      if (done) break
+      chunks.push(value)
+    }
+
+    expect(chunks.filter((chunk) => chunk.type === 'error')).toEqual([])
+  })
+
+  it('preserves stream validation for the official Anthropic provider', async () => {
+    const fetch = (() =>
+      Promise.resolve(
+        new Response('data: {"type":"conversation_ready"}\n\n', {
+          headers: { 'content-type': 'text/event-stream' },
+          status: 200
+        })
+      )) as typeof globalThis.fetch
+
+    await expect(
+      createAnthropic({ apiKey: 'test', fetch }).languageModel('claude-sonnet-4-6').doStream(textPrompt)
+    ).rejects.toThrow('No matching discriminator')
+  })
+
+  it('keeps unknown-model max token compatibility out of the official Anthropic provider', async () => {
+    const clewdrRequest = await captureWithFetch((fetch) =>
+      createClewdr({ apiKey: 'test', fetch }).languageModel('proxy-model').doStream(textPrompt)
+    )
+    const anthropicRequest = await captureWithFetch((fetch) =>
+      createAnthropic({ apiKey: 'test', fetch }).languageModel('proxy-model').doStream(textPrompt)
+    )
+
+    expect(clewdrRequest.body).not.toMatchObject({ max_tokens: expect.any(Number) })
+    expect(anthropicRequest.body).toMatchObject({ max_tokens: expect.any(Number) })
+  })
+
+  it('keeps explicit disabled thinking out of the official Anthropic provider', async () => {
+    const options: LanguageModelV3CallOptions = {
+      ...textPrompt,
+      providerOptions: { anthropic: { thinking: { type: 'disabled' } } }
+    }
+    const clewdrRequest = await captureWithFetch((fetch) =>
+      createClewdr({ apiKey: 'test', fetch }).languageModel('claude-sonnet-4-6').doStream(options)
+    )
+    const anthropicRequest = await captureWithFetch((fetch) =>
+      createAnthropic({ apiKey: 'test', fetch }).languageModel('claude-sonnet-4-6').doStream(options)
+    )
+
+    expect(clewdrRequest.body).toMatchObject({ thinking: { type: 'disabled' } })
+    expect(anthropicRequest.body).not.toMatchObject({ thinking: { type: 'disabled' } })
+  })
+})

+import { getProviderByModel } from '@renderer/services/AssistantService'
+import type { FileMetadata, Model, Provider } from '@renderer/types'
+import { FILE_TYPE } from '@renderer/types'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+vi.mock('@logger', () => ({
+  loggerService: {
+    withContext: () => ({ debug: vi.fn(), info: vi.fn(), warn: vi.fn(), error: vi.fn() })
+  }
+}))
+
+vi.mock('@renderer/services/AssistantService', () => ({
+  getProviderByModel: vi.fn(),
+  getAssistantSettings: vi.fn(),
+  getDefaultAssistant: vi.fn(() => ({ id: 'default', name: 'Default', settings: {} }))
+}))
+
+vi.mock('../modelCapabilities', () => ({
+  getFileSizeLimit: vi.fn(() => Infinity),
+  supportsImageInput: vi.fn(() => false),
+  supportsLargeFileUpload: vi.fn(() => false)
+}))
+
+import { convertFileBlockToFilePart } from '../fileProcessor'
+
+const model: Model = { id: 'claude-sonnet-4-6', name: 'Claude Sonnet 4.6', provider: 'clewdr', group: 'clewdr' }
+const file: FileMetadata = {
+  id: 'archive',
+  name: 'archive.zip',
+  origin_name: 'project.zip',
+  path: '/tmp/project.zip',
+  size: 4,
+  ext: '.zip',
+  type: FILE_TYPE.OTHER,
+  created_at: '2026-07-15T00:00:00.000Z',
+  count: 1
+}
+
+describe('fileProcessor Clewdr support', () => {
+  beforeEach(() => {
+    Object.defineProperty(globalThis, 'window', {
+      configurable: true,
+      value: {
+        api: {
+          file: {
+            base64File: vi.fn().mockResolvedValue({ data: 'UEsDBA==', mime: 'application/zip' })
+          }
+        }
+      }
+    })
+  })
+
+  it('converts any Clewdr attachment to a native file part', async () => {
+    vi.mocked(getProviderByModel).mockReturnValue({ id: 'clewdr', type: 'clewdr' } as Provider)
+
+    const result = await convertFileBlockToFilePart({ file } as Parameters<typeof convertFileBlockToFilePart>[0], model)
+
+    expect(window.api.file.base64File).toHaveBeenCalledWith('archive.zip')
+    expect(result).toEqual({
+      type: 'file',
+      data: 'UEsDBA==',
+      mediaType: 'application/zip',
+      filename: 'project.zip'
+    })
+  })
+
+  it('keeps unknown file types non-native for other providers', async () => {
+    vi.mocked(getProviderByModel).mockReturnValue({ id: 'openai', type: 'openai' } as Provider)
+
+    const result = await convertFileBlockToFilePart({ file } as Parameters<typeof convertFileBlockToFilePart>[0], model)
+
+    expect(result).toBeNull()
+    expect(window.api.file.base64File).not.toHaveBeenCalled()
+  })
+})

+const CLEWDR_OUTPUT_PATH_PATTERN =
+  /(?:^|[\s(`"'])((?:\/(?:[^\s/`"']+\/)*[^\s/`"']+)|(?:\.{1,2}[\\/][^\s`"']+)|(?:[A-Za-z]:[\\/][^\s`"']+))/m
+
+function hasClewdrOutputPath(text: string): boolean {
+  return CLEWDR_OUTPUT_PATH_PATTERN.test(text)
+}
+
+export function createClewdrFilesUrl(baseURL: string | undefined, sessionId: string): string {
+  const endpoint = baseURL?.trim() ? normalizeClewdrEndpoint(baseURL) : '/v1'
+  const filesURL = `${endpoint}/files`
+  if (filesURL.startsWith('/')) return `${filesURL}?session_id=${encodeURIComponent(sessionId)}`
+
+  const url = new URL(filesURL)
+  url.searchParams.set('session_id', sessionId)
+  return url.toString()
+}
+
+export function appendClewdrDownloadLink(text: string, baseURL: string | undefined, sessionId: string): string {
+  if (!hasClewdrOutputPath(text) || text.includes('[Download Files](')) return text
+  return `${text}\n\n[Download Files](${createClewdrFilesUrl(baseURL, sessionId)})`
+}
+
+function appendClewdrDownloadLinkToResponse(response: Response, baseURL: string, sessionId: string): Response {
+  if (!response.ok || !response.body || !response.headers.get('content-type')?.includes('text/event-stream')) {
+    return response
+  }
+
+  const encoder = new TextEncoder()
+  const decoder = new TextDecoder()
+  const downloadLink = createClewdrFilesUrl(baseURL, sessionId)
+  let buffered = ''
+  let assistantText = ''
+  let textBlockIndex = 0
+  let textBlockStopped = false
+  let linkAppended = false
+
+  const appendIfNeeded = (controller: TransformStreamDefaultController<Uint8Array>): void => {
+    if (linkAppended || !hasClewdrOutputPath(assistantText)) return
+    linkAppended = true
+    controller.enqueue(
+      encoder.encode(
+        `data: ${JSON.stringify({
+          type: 'content_block_delta',
+          index: textBlockIndex,
+          delta: { type: 'text_delta', text: `\n\n[Download Files](${downloadLink})` }
+        })}\n\n`
+      )
+    )
+  }
+
+  const inspectEvent = (event: string, controller: TransformStreamDefaultController<Uint8Array>): void => {
+    const data = event
+      .split(/\r?\n/)
+      .filter((line) => line.startsWith('data:'))
+      .map((line) => line.slice(5).trimStart())
+      .join('\n')
+    if (!data || data === '[DONE]') return
+
+    let parsed: unknown
+    try {
+      parsed = JSON.parse(data)
+    } catch {
+      return
+    }
+    if (typeof parsed !== 'object' || parsed === null || Array.isArray(parsed)) return
+    const eventData = parsed as { type?: unknown; index?: unknown; content_block?: unknown; delta?: unknown }
+    if (eventData.type === 'content_block_start' && typeof eventData.index === 'number') {
+      const contentBlock = eventData.content_block
+      if (typeof contentBlock === 'object' && contentBlock !== null && !Array.isArray(contentBlock)) {
+        const block = contentBlock as { type?: unknown }
+        if (block.type === 'text') textBlockIndex = eventData.index
+      }
+    }
+    if (eventData.type === 'content_block_delta' && typeof eventData.delta === 'object' && eventData.delta !== null) {
+      const delta = eventData.delta as { type?: unknown; text?: unknown }
+      if (delta.type === 'text_delta' && typeof delta.text === 'string') assistantText += delta.text
+    }
+    if (eventData.type === 'content_block_stop' && eventData.index === textBlockIndex) {
+      textBlockStopped = true
+      appendIfNeeded(controller)
+    }
+    if (eventData.type === 'message_stop' && !textBlockStopped) appendIfNeeded(controller)
+  }
+
+  const stream = new TransformStream<Uint8Array, Uint8Array>({
+    transform(chunk, controller) {
+      buffered += decoder.decode(chunk, { stream: true })
+      let boundary = buffered.indexOf('\n\n')
+      while (boundary !== -1) {
+        const event = buffered.slice(0, boundary + 2)
+        buffered = buffered.slice(boundary + 2)
+        inspectEvent(event, controller)
+        controller.enqueue(encoder.encode(event))
+        boundary = buffered.indexOf('\n\n')
+      }
+    },
+    flush(controller) {
+      buffered += decoder.decode()
+      if (buffered) {
+        inspectEvent(buffered, controller)
+        controller.enqueue(encoder.encode(buffered))
+      }
+      if (!textBlockStopped) appendIfNeeded(controller)
+    }
+  })
+
+  return new Response(response.body.pipeThrough(stream), response)
+}

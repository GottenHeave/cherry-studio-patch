+import type { AnthropicProviderSettings } from '@ai-sdk/anthropic'
+
+const SESSION_PREFIX = 'cherry_topic_v1_'
+const SESSION_HASH_DOMAIN = 'clewdr-cherry-session-v1'
+const MAX_STAGED_FILE_CACHE_ENTRIES = 1_024
+const stagedFiles = new Map<string, Promise<string>>()
+
+interface ClewdrRequestContext {
+  clientId: string
+  sessionId: string
+}
+
+interface ClewdrFileSource {
+  type: 'base64'
+  media_type: string
+  data: string
+}
+
+interface ClewdrFileReference {
+  type: 'file'
+  file_id: string
+}
+
+interface AnthropicContentBlock {
+  type?: string
+  title?: string
+  source?: ClewdrFileSource | ClewdrFileReference | unknown
+}
+
+interface AnthropicMessage {
+  content?: AnthropicContentBlock[] | string
+}
+
+interface AnthropicMessagesRequest {
+  messages?: AnthropicMessage[]
+  metadata?: Record<string, unknown>
+  tools?: unknown
+  tool_choice?: unknown
+}
+
+interface StagedFileResponse {
+  id: string
+  type: 'file'
+  filename: string
+  mime_type: string
+  size_bytes: number
+}
+
+interface PendingFileRewrite {
+  block: AnthropicContentBlock
+  source: ClewdrFileSource
+  filename: string
+}
+
+export interface ClewdrProviderContextSettings extends ClewdrRequestContext {
+  baseURL: string
+  providerInstanceId: string
+}
+
+export function normalizeClewdrEndpoint(endpoint: string): string {
+  const url = new URL(endpoint)
+  const pathname = url.pathname.replace(/\/+$/, '')
+  return `${url.origin}${pathname}`
+}
+
+async function sha256Hex(value: string | ArrayBuffer): Promise<string> {
+  const bytes = typeof value === 'string' ? new TextEncoder().encode(value) : value
+  const digest = await crypto.subtle.digest('SHA-256', bytes)
+  return Array.from(new Uint8Array(digest), (byte) => byte.toString(16).padStart(2, '0')).join('')
+}
+
+export async function createClewdrSessionId(settings: ClewdrProviderContextSettings): Promise<string> {
+  const endpoint = normalizeClewdrEndpoint(settings.baseURL)
+  const digest = await sha256Hex(`${SESSION_HASH_DOMAIN}\0${settings.clientId}\0${endpoint}\0${settings.sessionId}`)
+  return `${SESSION_PREFIX}${digest}`
+}
+
+function rememberStagedFile(cacheKey: string, fileId: Promise<string>): void {
+  stagedFiles.delete(cacheKey)
+  stagedFiles.set(cacheKey, fileId)
+  while (stagedFiles.size > MAX_STAGED_FILE_CACHE_ENTRIES) {
+    const oldestKey = stagedFiles.keys().next().value
+    if (oldestKey) stagedFiles.delete(oldestKey)
+  }
+}
+
+function isBase64FileSource(source: AnthropicContentBlock['source']): source is ClewdrFileSource {
+  if (typeof source !== 'object' || source === null) return false
+  const candidate = source as Partial<ClewdrFileSource>
+  return candidate.type === 'base64' && typeof candidate.media_type === 'string' && typeof candidate.data === 'string'
+}
+
+function normalizeFilename(filename: string | undefined): string {
+  const basename = filename?.replaceAll('\\', '/').split('/').filter(Boolean).at(-1) ?? 'file'
+  const printable = [...basename].filter((character) => {
+    const codePoint = character.codePointAt(0) ?? 0
+    return codePoint > 0x1f && codePoint !== 0x7f
+  })
+  return printable.join('').trim() || 'file'
+}
+
+function decodeBase64(data: string): ArrayBuffer {
+  const binary = atob(data)
+  const buffer = new ArrayBuffer(binary.length)
+  const bytes = new Uint8Array(buffer)
+  for (let index = 0; index < binary.length; index += 1) {
+    bytes[index] = binary.charCodeAt(index)
+  }
+  return buffer
+}
+
+function getRequestUrl(input: RequestInfo | URL): string {
+  return input instanceof Request ? input.url : String(input)
+}
+
+function cloneHeadersWithout(headers: HeadersInit | undefined, names: string[]): Headers {
+  const result = new Headers(headers)
+  for (const name of names) result.delete(name)
+  return result
+}
+
+function mergeHeaders(input: RequestInfo | URL, headers: HeadersInit | undefined): Headers {
+  const result = input instanceof Request ? new Headers(input.headers) : new Headers()
+  new Headers(headers).forEach((value, key) => result.set(key, value))
+  return result
+}
+
+function getPrincipalMaterial(headers: Headers, apiKey: string | undefined): string {
+  return headers.get('x-api-key') || headers.get('authorization') || apiKey || ''
+}
+
+function collectFileRewrites(body: AnthropicMessagesRequest): PendingFileRewrite[] {
+  const rewrites: PendingFileRewrite[] = []
+  for (const message of body.messages || []) {
+    if (!Array.isArray(message.content)) continue
+    for (const block of message.content) {
+      if ((block.type === 'document' || block.type === 'image') && isBase64FileSource(block.source)) {
+        rewrites.push({ block, source: block.source, filename: normalizeFilename(block.title) })
+      }
+    }
+  }
+  return rewrites
+}
+
+async function parseStagedFileResponse(response: Response): Promise<StagedFileResponse> {
+  if (!response.ok) {
+    const error = new Error(`Clewdr file upload failed with status ${response.status}`)
+    Object.assign(error, { statusCode: response.status, responseBody: await response.text() })
+    throw error
+  }
+  const value = (await response.json()) as Partial<StagedFileResponse>
+  if (
+    typeof value.id !== 'string' ||
+    value.type !== 'file' ||
+    typeof value.filename !== 'string' ||
+    typeof value.mime_type !== 'string' ||
+    typeof value.size_bytes !== 'number'
+  ) {
+    throw new Error('Clewdr file upload returned an invalid response')
+  }
+  return value as StagedFileResponse
+}
+
+export function createClewdrFetch(
+  options: AnthropicProviderSettings,
+  context: ClewdrProviderContextSettings
+): typeof globalThis.fetch {
+  const fetch = options.fetch || globalThis.fetch
+  const endpoint = normalizeClewdrEndpoint(context.baseURL)
+
+  return async (input: RequestInfo | URL, init?: RequestInit): Promise<Response> => {
+    const requestUrl = getRequestUrl(input)
+    const requestPath = new URL(requestUrl).pathname.replace(/\/+$/, '')
+    if (!requestPath.endsWith('/messages') || typeof init?.body !== 'string') {
+      return fetch(input, init)
+    }
+
+    const body = JSON.parse(init.body) as AnthropicMessagesRequest
+    const sessionId = await createClewdrSessionId(context)
+    const originalHeaders = mergeHeaders(input, init.headers)
+    const principal = await sha256Hex(getPrincipalMaterial(originalHeaders, options.apiKey))
+    const rewrites = collectFileRewrites(body)
+
+    await Promise.all(
+      rewrites.map(async ({ block, source, filename }) => {
+        const bytes = decodeBase64(source.data)
+        const contentDigest = await sha256Hex(bytes)
+        const cacheKey = [
+          context.providerInstanceId,
+          endpoint,
+          principal,
+          sessionId,
+          contentDigest,
+          filename,
+          source.media_type
+        ].join('\0')
+        let fileId = stagedFiles.get(cacheKey)
+        if (!fileId) {
+          fileId = (async () => {
+            const form = new FormData()
+            form.append('file', new Blob([bytes], { type: source.media_type }), filename)
+            const uploadResponse = await fetch(`${endpoint}/files`, {
+              method: 'POST',
+              headers: cloneHeadersWithout(originalHeaders, ['content-length', 'content-type']),
+              body: form,
+              signal: init.signal
+            })
+            return (await parseStagedFileResponse(uploadResponse)).id
+          })()
+          rememberStagedFile(cacheKey, fileId)
+          fileId.catch(() => stagedFiles.delete(cacheKey))
+        }
+        block.source = { type: 'file', file_id: await fileId }
+      })
+    )
+
+    body.metadata = { ...body.metadata, user_id: sessionId }
+    delete body.tools
+    delete body.tool_choice
+
+    const messageInit: RequestInit = {
+      ...init,
+      headers: cloneHeadersWithout(originalHeaders, ['content-length']),
+      body: JSON.stringify(body)
+    }
+    const firstResponse = await fetch(input, messageInit)
+    if (firstResponse.status !== 410) return firstResponse
+    await firstResponse.body?.cancel()
+
+    const resetHeaders = cloneHeadersWithout(originalHeaders, ['content-length'])
+    resetHeaders.set('content-type', 'application/json')
+    const resetResponse = await fetch(`${endpoint}/sessions/reset`, {
+      method: 'POST',
+      headers: resetHeaders,
+      body: JSON.stringify({ session_id: sessionId }),
+      signal: init.signal
+    })
+    if (!resetResponse.ok) return resetResponse
+    return fetch(input, messageInit)
+  }
+}

+import type { Model, Provider } from '@renderer/types'
+import { describe, expect, it } from 'vitest'
+
+import { buildPlugins } from '../PluginBuilder'
+
+describe('Clewdr plugin isolation', () => {
+  it('excludes every local tool plugin even when middleware flags are enabled', () => {
+    const model = { id: 'claude-sonnet-4-6', name: 'Claude Sonnet 4.6', provider: 'clewdr' } as Model
+    const provider: Provider = {
+      id: 'clewdr-instance',
+      type: 'clewdr',
+      name: 'Clewdr',
+      apiKey: 'test',
+      apiHost: 'https://clewdr.example/v1',
+      models: [model]
+    }
+    const assistant = { id: 'assistant', name: 'Assistant', prompt: '', topics: [], type: 'assistant', model }
+
+    const plugins = buildPlugins({
+      provider,
+      model,
+      config: {
+        assistant,
+        streamOutput: true,
+        enableReasoning: false,
+        enableWebSearch: true,
+        enableGenerateImage: false,
+        enableUrlContext: true,
+        isPromptToolUse: true,
+        isSupportedToolUse: true,
+        webSearchPluginConfig: {},
+        urlContextConfig: {},
+        mcpMode: 'auto'
+      }
+    })
+
+    expect(plugins.map((plugin) => plugin.name)).not.toEqual(
+      expect.arrayContaining(['webSearch', 'urlContext', 'search-orchestration', 'built-in:prompt-tool-use'])
+    )
+  })
+})

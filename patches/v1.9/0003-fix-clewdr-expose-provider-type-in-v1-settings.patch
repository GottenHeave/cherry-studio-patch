+++ b/src/renderer/src/pages/settings/ProviderSettings/__tests__/AddProviderPopup.test.tsx
@@ -0,0 +1,49 @@
+import { fireEvent, render, screen } from '@testing-library/react'
+import { TopView } from '@renderer/components/TopView'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+
+import AddProviderPopup from '../AddProviderPopup'
+
+vi.mock('@renderer/components/TopView', () => ({
+  TopView: {
+    hide: vi.fn(),
+    show: vi.fn()
+  }
+}))
+
+vi.mock('react-i18next', () => ({
+  initReactI18next: {
+    type: '3rdParty',
+    init: vi.fn()
+  },
+  useTranslation: () => ({
+    t: (key: string) => key
+  })
+}))
+
+describe('AddProviderPopup', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    Object.defineProperty(window, 'matchMedia', {
+      writable: true,
+      value: vi.fn().mockImplementation(() => ({
+        matches: false,
+        addListener: vi.fn(),
+        removeListener: vi.fn()
+      }))
+    })
+  })
+
+  it('offers Clewdr as a provider type', () => {
+    void AddProviderPopup.show()
+
+    const popup = vi.mocked(TopView.show).mock.calls[0][0]
+    if (typeof popup === 'function') {
+      throw new TypeError('Expected AddProviderPopup to render a React node')
+    }
+    render(popup)
+    fireEvent.mouseDown(screen.getByRole('combobox'))
+
+    expect(screen.getByText('Clewdr')).toBeInTheDocument()
+  })
+})
